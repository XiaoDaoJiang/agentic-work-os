{
  "name": "@agentic-work-os/milestone-0-harness",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "test": "node --test",
    "test:cross-platform": "node --test test/local-runner-contract.test.mjs test/repository-marker-identity.test.mjs test/rust-runner-client.test.mjs",
    "check": "node scripts/check-modules.mjs",
    "test:rust": "cargo test --manifest-path runner-rs/Cargo.toml",
